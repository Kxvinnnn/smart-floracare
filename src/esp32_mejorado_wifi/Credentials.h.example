/**
 * ============================================================================
 * PLANTILLA DE CONFIGURACIÓN DE CREDENCIALES - SMART FLORACARE (ESP32)
 * ============================================================================
 * Instrucciones:
 * 1. Copia este archivo con el nombre "Credentials.h" en esta misma carpeta:
 *    src/esp32_mejorado_wifi/Credentials.h
 * 2. Modifica los valores con los datos reales de tu red Wi-Fi y genera un token
 *    secreto de al menos 16 caracteres alfanuméricos.
 * 3. IMPORTANTE: "Credentials.h" se encuentra listado en .gitignore para evitar
 *    que tus claves personales se publiquen en repositorios públicos.
 * ============================================================================
 */

#pragma once

// Nombre de la red Wi-Fi local (2.4 GHz)
#define SECRET_WIFI_SSID "TU_RED_WIFI"

// Contraseña de la red Wi-Fi local
#define SECRET_WIFI_PASS "TU_CONTRASENA_WIFI"

// Token de autorización para la API HTTP (mínimo 16 caracteres)
// Ejemplo: "fc_live_9a8b7c6d5e4f3a2b1c"
#define SECRET_API_TOKEN "GENERA_UN_TOKEN_SECRETO_DE_16_O_MAS_CARACTERES"
